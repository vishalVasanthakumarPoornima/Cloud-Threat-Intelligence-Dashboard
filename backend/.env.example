APP_ENV=development
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://threatintel:threatintel@localhost:5432/threatintel
ALLOW_PRIVATE_IOCS=false
MAX_REQUEST_BYTES=8192
MAX_UPLOAD_FILE_BYTES=33554432
NMAP_PATH=
NMAP_USE_SUDO=false
NMAP_SUDO_PATH=/usr/bin/sudo
ANALYZE_RATE_LIMIT_PER_MINUTE=30
CONNECTOR_TIMEOUT_SECONDS=12

# External threat intelligence API keys stay server-side only.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
IPINFO_TOKEN=

# Optional analyst summary provider. Leave disabled to use the deterministic local summary.
# Supported values: gemini, groq, xai.
AI_PROVIDER=disabled
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
XAI_MODEL=grok-3-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
